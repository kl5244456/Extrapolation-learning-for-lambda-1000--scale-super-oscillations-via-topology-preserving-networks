import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
import scipy.io as sio
import copy
from torch.utils.data import DataLoader, TensorDataset
from sklearn.model_selection import train_test_split
from google.colab import files

# ==========================================
# 1. 数据集构建
# ==========================================
def generate_cheby_zeros(N_lines, ctrlrgn, peakval):
    n = int(np.ceil((N_lines - 1) / 2))
    try:
        x0 = np.cosh(np.acosh(peakval) / n)
        alpha = (1 + x0) / (1 - np.cos(ctrlrgn))
        beta = x0 - alpha
        v_z = np.cos(np.pi * (2 * np.arange(1, n + 1) - 1) / (2 * n))
        zu = (v_z - beta) / alpha
        zn = []
        for val in zu:
            if abs(val) <= 1:
                zn.append(val + 1j * np.sqrt(1 - val**2))
                zn.append(val - 1j * np.sqrt(1 - val**2))
        return np.array(zn)
    except: return np.array([])

def create_dataset(num_samples=3000):
    lam, NA = 632.8e-9, 1.0
    k_max = (2 * np.pi / lam) * NA
    N_lines = 33
    delk = 2 * k_max / N_lines
    all_inputs, all_targets = [], []
    while len(all_inputs) < num_samples:
        W = np.random.uniform(1.2, 3.0)
        pv = np.random.uniform(2.5, 15.0)
        zn = generate_cheby_zeros(N_lines, delk * W * lam, pv)
        if len(zn) == 0: continue
        angles = np.angle(zn)
        pos_angles = angles[angles > 0]
        if len(pos_angles) == 0: continue
        actual_res = np.min(pos_angles) / delk / lam
        all_inputs.append([W, actual_res])
        all_targets.append(np.concatenate([zn.real, zn.imag]))
    return np.array(all_inputs), np.array(all_targets)

# ==========================================
# 2. 网络架构
# ==========================================
class SuperResNet(nn.Module):
    def __init__(self, mode='Baseline'):
        super(SuperResNet, self).__init__()
        self.mode = mode # 'Baseline', 'Soft', 'Hard'
        self.net = nn.Sequential(
            nn.Linear(2, 256), nn.ReLU(),
            nn.Linear(256, 512), nn.ReLU(),
            nn.Linear(512, 1024), nn.ReLU(),
            nn.Linear(1024, 64)
        )

    def forward(self, x):
        out = self.net(x)
        if self.mode == 'Hard':
            real = out[:, :32]; imag = out[:, 32:]
            norm = torch.sqrt(real**2 + imag**2)
            out = torch.cat([real/norm, imag/norm], dim=1)
        return out

# ==========================================
# 3. 
# ==========================================
num_runs = 50
target_points = np.array([0.001, 0.0008, 0.0006, 0.0004, 0.0002, 0.0001])
lam, NA = 632.8e-9, 1.0
k_max = (2 * np.pi / lam) * NA
delk = 2 * k_max / 33
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

modes = ['Baseline', 'Soft-Constraint', 'Hard-Constraint']
results_storage = {m: {'stats': [], 'zeros': np.zeros((num_runs, len(target_points), 32), dtype=complex)} for m in modes}

X_raw, Y_raw = create_dataset(5000)
X_train, X_val, Y_train, Y_val = train_test_split(
    X_raw, Y_raw, test_size=0.20, random_state=42, shuffle=True
)

train_loader = DataLoader(TensorDataset(torch.FloatTensor(X_train), torch.FloatTensor(Y_train)), batch_size=128, shuffle=True)
val_x = torch.FloatTensor(X_val).to(device)
val_y = torch.FloatTensor(Y_val).to(device)

print(f"🚀 Starting Multi-Constraint Statistical Analysis (50 Runs x 3 Modes)...")

for mode in modes:
    print(f"\n==================== Mode: {mode} ====================")
    for run_id in range(num_runs):

        model_mode = 'Hard' if mode == 'Hard-Constraint' else 'Baseline'
        model = SuperResNet(mode=model_mode).to(device)
        optimizer = optim.Adam(model.parameters(), lr=5e-4)
        mse_criterion = nn.MSELoss()

        scheduler = optim.lr_scheduler.ReduceLROnPlateau(
            optimizer, mode='min', factor=0.5, patience=8, min_lr=1e-6
        )

        best_val_loss = np.inf
        best_model_state = None
        max_epochs = 400    
        patience = 20         
        patience_counter = 0
        min_delta = 1e-8    

        for epoch in range(max_epochs):
            model.train()
            epoch_loss = 0.0
            for bx, by in train_loader:
                bx, by = bx.to(device), by.to(device)
                optimizer.zero_grad()
                out = model(bx)

                loss = mse_criterion(out, by)

                if mode == 'Soft-Constraint':
                    real = out[:, :32]; imag = out[:, 32:]
                    radii = torch.sqrt(real**2 + imag**2)
                    physics_loss = torch.mean((radii - 1.0)**2)
                    loss += 0.1 * physics_loss

                loss.backward()
                optimizer.step()
                epoch_loss += loss.item()

            model.eval()
            with torch.no_grad():
                val_out = model(val_x)
                val_loss = mse_criterion(val_out, val_y).item()

                # Soft
                if mode == 'Soft-Constraint':
                    v_real = val_out[:, :32]; v_imag = val_out[:, 32:]
                    v_radii = torch.sqrt(v_real**2 + v_imag**2)
                    v_physics = torch.mean((v_radii - 1.0)**2).item()
                    val_loss += 0.1 * v_physics

            scheduler.step(val_loss)

            if val_loss < best_val_loss - min_delta:
                best_val_loss = val_loss
                best_model_state = copy.deepcopy(model.state_dict()) 
                patience_counter = 0
            else:
                patience_counter += 1

            if patience_counter >= patience:
                break

        model.load_state_dict(best_model_state)

        # 3.2
        model.eval()
        for idx, tp in enumerate(target_points):
            with torch.no_grad():
                t_in = torch.FloatTensor([[1.8, tp]]).to(device)
                pred = model(t_in).cpu().numpy()[0]
                zn = pred[:32] + 1j * pred[32:]

                angles = np.angle(zn)
                p_angs = angles[angles > 0]; n_angs = angles[angles < 0]
                if len(p_angs) > 0 and len(n_angs) > 0:
                    m_res = (np.min(p_angs) + np.abs(np.max(n_angs))) / (2 * delk * lam)
                else: m_res = np.nan

                results_storage[mode]['stats'].append({'Target': tp, 'Measured': m_res, 'Type': mode})
                results_storage[mode]['zeros'][run_id, idx, :] = zn

        if (run_id + 1) % 10 == 0:
            print(f"-> {mode} | Run {run_id+1:02d}/{num_runs} | Best Loss: {best_val_loss:.6e} | Stopped at Epoch {epoch}")

# ==========================================
# 4.
# ==========================================
df_all = pd.concat([pd.DataFrame(results_storage[m]['stats']) for m in modes])
plt.figure(figsize=(15, 8), dpi=150)
sns.set_style("white")

ax = sns.boxplot(x='Target', y='Measured', hue='Type', data=df_all, order=target_points, palette='viridis')
plt.plot(np.arange(len(target_points)), target_points, 'r--', lw=2, label='Ideal Reference ($y=x$)')

plt.gca().invert_xaxis()
plt.title("Constraint Comparison: Baseline vs Soft (Loss) vs Hard (Architecture)", fontweight='bold', fontsize=16)
plt.xlabel(r"Target Resolution $\sigma$ ($\lambda$)", fontsize=14)
plt.ylabel(r"Measured Resolution $\sigma_{meas}$ ($\lambda$)", fontsize=14)
plt.legend(fontsize=12, loc='upper left')
plt.grid(axis='y', alpha=0.2)
plt.tight_layout()
plt.show()

mat_save_data = {
    'target_points': target_points,
    'baseline_zeros': results_storage['Baseline']['zeros'],
    'soft_zeros': results_storage['Soft-Constraint']['zeros'],
    'hard_zeros': results_storage['Hard-Constraint']['zeros']
}
sio.savemat('Soft_vs_Hard_Comparison.mat', mat_save_data)
files.download('Soft_vs_Hard_Comparison.mat')
