import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
import scipy.io as sio
from torch.utils.data import DataLoader, TensorDataset
from google.colab import files

# ==========================================
# 1. 
# ==========================================
def generate_cheby_zeros(N_lines, ctrlrgn, peakval):
    n = int(np.ceil((N_lines - 1) / 2))
    try:
        x0 = np.cosh(np.acosh(peakval) / n)
        alpha = (1 + x0) / (1 - np.cos(ctrlrgn))
        beta = x0 - alpha
        v_z = np.cos(np.pi * (2 * np.arange(1, n + 1) - 1) / (2 * n))
        zu = (v_z - beta) / alpha
        zn = []
        for val in zu:
            if abs(val) <= 1:
                zn.append(val + 1j * np.sqrt(1 - val**2))
                zn.append(val - 1j * np.sqrt(1 - val**2))
        return np.array(zn)
    except: return np.array([])

def create_dataset(num_samples=5000):
    lam, NA = 632.8e-9, 1.0
    k_max = (2 * np.pi / lam) * NA
    N_lines = 33
    delk = 2 * k_max / N_lines
    all_inputs, all_targets = [], []
    while len(all_inputs) < num_samples:
        W = np.random.uniform(1.2, 3.0)
        pv = np.random.uniform(2.5, 15.0)
        zn = generate_cheby_zeros(N_lines, delk * W * lam, pv)
        if len(zn) == 0: continue
        angles = np.angle(zn)
        pos_angles = angles[angles > 0]
        if len(pos_angles) == 0: continue
        actual_res = np.min(pos_angles) / delk / lam
        all_inputs.append([W, actual_res])
        all_targets.append(np.concatenate([zn.real, zn.imag]))
    return np.array(all_inputs), np.array(all_targets)

# ==========================================
# 2. 
# ==========================================
class SuperResNet(nn.Module):
    def __init__(self, mode='Baseline'):
        super(SuperResNet, self).__init__()
        self.mode = mode # 'Baseline', 'Soft', 'Hard'
        self.net = nn.Sequential(
            nn.Linear(2, 256), nn.ReLU(),
            nn.Linear(256, 512), nn.ReLU(),
            nn.Linear(512, 1024), nn.ReLU(),
            nn.Linear(1024, 64)
        )

    def forward(self, x):
        out = self.net(x)
        if self.mode == 'Hard':
            real = out[:, :32]; imag = out[:, 32:]
            norm = torch.sqrt(real**2 + imag**2)
            out = torch.cat([real/norm, imag/norm], dim=1)
        return out

# ==========================================
# 3. 
# ==========================================
num_runs = 50
target_points = np.array([0.01, 0.008, 0.006, 0.004, 0.002, 0.001])
lam, NA = 632.8e-9, 1.0
k_max = (2 * np.pi / lam) * NA
delk = 2 * k_max / 33
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

modes = ['Baseline', 'Soft-Constraint', 'Hard-Constraint']
results_storage = {m: {'stats': [], 'zeros': np.zeros((num_runs, len(target_points), 32), dtype=complex)} for m in modes}

X_train, Y_train = create_dataset(3000)
train_loader = DataLoader(TensorDataset(torch.FloatTensor(X_train), torch.FloatTensor(Y_train)), batch_size=128, shuffle=True)

for mode in modes:
    print(f"\n🚀 Start training mode: {mode}...")
    for run_id in range(num_runs):
        # 
        model_mode = 'Hard' if mode == 'Hard-Constraint' else 'Baseline'
        model = SuperResNet(mode=model_mode).to(device)
        optimizer = optim.Adam(model.parameters(), lr=0.0005)
        mse_criterion = nn.MSELoss()

        model.train()
        for epoch in range(121):
            for bx, by in train_loader:
                bx, by = bx.to(device), by.to(device)
                optimizer.zero_grad()
                out = model(bx)

                loss = mse_criterion(out, by)

                # --- Soft constraint ---
                if mode == 'Soft-Constraint':
                    real = out[:, :32]; imag = out[:, 32:]
                    radii = torch.sqrt(real**2 + imag**2)
                    # penalty
                    physics_loss = torch.mean((radii - 1.0)**2)
                    loss += 0.1 * physics_loss 

                loss.backward()
                optimizer.step()

        model.eval()
        for idx, tp in enumerate(target_points):
            with torch.no_grad():
                t_in = torch.FloatTensor([[1.8, tp]]).to(device)
                pred = model(t_in).cpu().numpy()[0]
                zn = pred[:32] + 1j * pred[32:]

                angles = np.angle(zn)
                p_angs = angles[angles > 0]; n_angs = angles[angles < 0]
                if len(p_angs) > 0 and len(n_angs) > 0:
                    m_res = (np.min(p_angs) + np.abs(np.max(n_angs))) / (2 * delk * lam)
                else: m_res = np.nan

                results_storage[mode]['stats'].append({'Target': tp, 'Measured': m_res, 'Type': mode})
                results_storage[mode]['zeros'][run_id, idx, :] = zn

        if (run_id + 1) % 10 == 0: print(f"Run {run_id+1}/{num_runs} 完成")

# ==========================================
# 4. 
# ==========================================
df_all = pd.concat([pd.DataFrame(results_storage[m]['stats']) for m in modes])
plt.figure(figsize=(15, 8), dpi=150)
sns.boxplot(x='Target', y='Measured', hue='Type', data=df_all, order=target_points, palette='viridis')
plt.plot(np.arange(len(target_points)), target_points, 'r--', lw=2, label='Ideal Reference')
plt.gca().invert_xaxis()
plt.title("Constraint Comparison: Baseline vs Soft (Loss) vs Hard (Architecture)", fontweight='bold')
plt.show()
