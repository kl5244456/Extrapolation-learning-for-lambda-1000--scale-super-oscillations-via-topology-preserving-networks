import torch
import torch.nn as nn
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import matplotlib.colors as mcolors
from mpl_toolkits.mplot3d import Axes3D
import numpy as np

# ==========================================
# 1. 检测设备
# ==========================================
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# ==========================================
# 2. 核心绘图函数 (保持你的精美学术级排版不变)
# ==========================================
def plot_figure_2_3D_v3(model, X_raw, device, min_res_train):
    plt.rcParams.update({
        'font.family': 'sans-serif',
        'font.size': 11,
        'axes.linewidth': 1.5,
        'mathtext.fontset': 'stix'
    })

    fig = plt.figure(figsize=(18, 12), dpi=150, constrained_layout=True)
    gs = gridspec.GridSpec(2, 2, figure=fig, width_ratios=[1, 1.2])
    model.eval()

    # --- (A) Latent Space PCA ---
    ax_a = fig.add_subplot(gs[0, 0])
    with torch.no_grad():
        # 增加安全防御：防止 X_raw 样本数不足 2000 导致报错
        n_samples = min(len(X_raw), 2000)
        subset_idx = np.random.choice(len(X_raw), n_samples, replace=False)
        x_sub = torch.FloatTensor(X_raw[subset_idx, :2]).to(device)
        latent_features = model.net[:6](x_sub).cpu().numpy()
    pca = PCA(n_components=2)
    latent_2d = pca.fit_transform(latent_features)
    sc = ax_a.scatter(latent_2d[:, 0], latent_2d[:, 1], c=X_raw[subset_idx, 1], cmap='plasma', s=15, alpha=0.6)
    ax_a.set_title("A. Latent Manifold Projection", fontweight='bold', pad=15)
    ax_a.set_xlabel("Latent PC 1"); ax_a.set_ylabel("Latent PC 2")
    plt.colorbar(sc, ax=ax_a, label=r"Resolution ($\sigma/\lambda$)")

    # --- (B) 3D Analytic Trajectories ---
    ax_b = fig.add_subplot(gs[0, 1], projection='3d')
    res_sweep = np.linspace(0.4, min_res_train * 0.1, 200)
    w_fixed = 1.8
    trajectories = []
    for r in res_sweep:
        with torch.no_grad():
            t_in = torch.FloatTensor([[w_fixed, r]]).to(device)
            pred = model(t_in).cpu().numpy()[0]
            trajectories.append(pred[:32] + 1j * pred[32:])
    trajectories = np.array(trajectories) # [200, 32]

    u = np.linspace(0, 2 * np.pi, 100)
    z_cyl = np.linspace(res_sweep.min(), res_sweep.max(), 10)
    U, Z = np.meshgrid(u, z_cyl)
    X_cyl, Y_cyl = np.cos(U), np.sin(U)
    ax_b.plot_surface(X_cyl, Y_cyl, Z, color='gray', alpha=0.05, zorder=0)

    for z_idx in range(32):
        x_traj = trajectories[:, z_idx].real
        y_traj = trajectories[:, z_idx].imag
        ax_b.plot(x_traj, y_traj, res_sweep, color=plt.cm.viridis(z_idx/32), lw=2, alpha=0.8)
        ax_b.scatter(x_traj[-1], y_traj[-1], res_sweep[-1], color='red', s=10)

    ax_b.set_title(r"B. 3D Zero Evolution Manifold ($z$ vs $\sigma$)", fontweight='bold', pad=20)
    ax_b.set_xlabel("Re(z)"); ax_b.set_ylabel("Im(z)"); ax_b.set_zlabel(r"Resolution ($\sigma/\lambda$)")
    ax_b.view_init(elev=20, azim=45) 

    # --- (D) Constraint Fidelity ---
    ax_d = fig.add_subplot(gs[1, 0])
    depths = [1.5, 1.0, 0.5, 0.25, 0.1]
    devs = []
    for d in depths:
        with torch.no_grad():
            t_in = torch.FloatTensor([[1.8, min_res_train*d]]).to(device)
            p = model(t_in).cpu().numpy()[0]
            zn = p[:32] + 1j * p[32:]
            devs.append(np.mean(np.abs(np.abs(zn) - 1.0)))
    ax_d.bar([f"{d}x" for d in depths], devs, color='navy', alpha=0.7, edgecolor='black')
    ax_d.set_yscale('log')
    ax_d.set_title(r"D. Radial Drift from Unit Circle ($|z|-1$)", fontweight='bold', pad=15)
    ax_d.set_xlabel("Extrapolation Depth"); ax_d.set_ylabel("Mean Absolute Deviation")

    # --- (E) Global Analyticity Residual Map ---
    ax_e = fig.add_subplot(gs[1, 1])
    W_m, R_m = np.meshgrid(np.linspace(1.2, 3.0, 80), np.linspace(min_res_train*0.1, 2.5, 80))
    m_in = torch.FloatTensor(np.stack([W_m.ravel(), R_m.ravel()], axis=1)).to(device)
    with torch.no_grad():
        preds = model(m_in).cpu().numpy()
        resid = np.mean(np.abs(np.sqrt(preds[:, :32]**2 + preds[:, 32:]**2) - 1.0), axis=1).reshape(W_m.shape)

    im = ax_e.pcolormesh(W_m, R_m, resid, cmap='magma', shading='auto', norm=mcolors.LogNorm(vmin=1e-4, vmax=1e-1))
    ax_e.axhline(min_res_train, color='white', linestyle='--', lw=2, label='Training Boundary')
    ax_e.set_title("E. Global Analyticity Residual Map", fontweight='bold', pad=15)
    ax_e.set_xlabel(r"ROI Width ($W/\lambda$)"); ax_e.set_ylabel(r"Resolution ($\sigma/\lambda$)")
    plt.colorbar(im, ax=ax_e, label='Mean Unit-Circle Violation')
    ax_e.legend(loc='upper right')

    plt.suptitle("Figure 2: Neural Interpretation of Super-oscillatory Analytic Manifold", fontsize=22, fontweight='bold')
    plt.show()

# ==========================================
# 3.
# ==========================================
try:
    # 确保模型已经切换到正确的设备
    model.to(device)
    
    # 动态检查所需变量是否存在于当前环境的内存中
    if 'X_raw' in locals() and 'min_res_train' in locals():
        print(">>> 检测到内存中的原始数据集和边界，正在直接渲染图表...")
        plot_figure_2_3D_v3(model, X_raw, device, min_res_train)
    else:
        print("⚠️ 警告：当前会话中未找到 X_raw 或 min_res_train 变量！")
        print("请确保你在运行此脚本前，已经成功运行了前面的数据集生成/训练单元格。")
except NameError:
    print("⚠️ 错误：在当前内存中找不到名为 'model' 的神经网络对象！")
    print("请确认包含 'model = SuperResNet()' 的训练代码已经完整跑完。")
