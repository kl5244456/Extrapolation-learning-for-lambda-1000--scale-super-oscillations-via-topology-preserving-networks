plt.gca().invert_xaxis()

plt.title(f"Figure 3a: Statistical Robustness (50 Independent Runs)", fontweight='bold', fontsize=16)
plt.xlabel(r"Target Resolution $\sigma$ ($\lambda$)", fontsize=14)
plt.ylabel(r"Measured Resolution $\sigma_{meas}$ ($\lambda$)", fontsize=14)
plt.legend(fontsize=12)
plt.grid(axis='y', alpha=0.2)

plt.show()

