# 3. 
# ==========================================
df = pd.DataFrame(all_stats_data)
train_limit = np.min(X_raw[:, 1]) 

plt.figure(figsize=(12, 8), dpi=150)
sns.set_style("white")

ax = sns.boxplot(x='Target', y='Measured', data=df,
                 order=target_points,
                 palette='viridis', fliersize=5)

x_indices = np.arange(len(target_points))
plt.plot(x_indices, target_points, 'r--', lw=2, label='Ideal Reference ($y=x$)')

plt.axhline(y=train_limit, color='gray', linestyle=':', lw=2, label=f'Training Limit ({train_limit:.4f}λ)')
 
plt.gca().invert_xaxis()

plt.title(f"Figure 3a: Statistical Robustness Across 50 Standardized Runs", fontweight='bold', fontsize=16)
plt.xlabel(r"Target Resolution $\sigma$ ($\lambda$)", fontsize=14)
plt.ylabel(r"Measured Resolution $\sigma_{meas}$ ($\lambda$)", fontsize=14)
plt.legend(fontsize=12, loc='upper left')
plt.grid(axis='y', alpha=0.2)

plt.show()
