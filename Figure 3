import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
import scipy.io as sio
import copy
from torch.utils.data import DataLoader, TensorDataset
from sklearn.model_selection import train_test_split

# ==========================================
# 1.
# ==========================================
def generate_cheby_zeros(N_lines, ctrlrgn, peakval):
    n = int(np.ceil((N_lines - 1) / 2))
    try:
        x0 = np.cosh(np.acosh(peakval) / n)
        alpha = (1 + x0) / (1 - np.cos(ctrlrgn))
        beta = x0 - alpha
        v_z = np.cos(np.pi * (2 * np.arange(1, n + 1) - 1) / (2 * n))
        zu = (v_z - beta) / alpha
        zn = []
        for val in zu:
            if abs(val) <= 1:
                zn.append(val + 1j * np.sqrt(1 - val**2))
                zn.append(val - 1j * np.sqrt(1 - val**2))
        return np.array(zn)
    except: return np.array([])

def create_dataset(num_samples=3000):
    lam, NA = 632.8e-9, 1.0
    k_max = (2 * np.pi / lam) * NA
    N_lines = 33
    delk = 2 * k_max / N_lines
    all_inputs, all_targets = [], []
    while len(all_inputs) < num_samples:
        W = np.random.uniform(1.2, 3.0)
        pv = np.random.uniform(2.5, 15.0)
        zn = generate_cheby_zeros(N_lines, delk * W * lam, pv)
        if len(zn) == 0: continue
        angles = np.angle(zn)
        pos_angles = angles[angles > 0]
        if len(pos_angles) == 0: continue
        actual_res = np.min(pos_angles) / delk / lam
        all_inputs.append([W, actual_res])
        all_targets.append(np.concatenate([zn.real, zn.imag]))
    return np.array(all_inputs), np.array(all_targets)

class SuperResNet(nn.Module):
    def __init__(self):
        super(SuperResNet, self).__init__()
        self.net = nn.Sequential(
            nn.Linear(2, 256), nn.ReLU(),
            nn.Linear(256, 512), nn.ReLU(),
            nn.Linear(512, 1024), nn.ReLU(),
            nn.Linear(1024, 64)
        )
    def forward(self, x): return self.net(x)

# ==========================================
# 2.
# ==========================================
num_runs = 50
target_points = np.array([0.4, 0.3, 0.2, 0.1, 0.08, 0.06, 0.04, 0.02, 0.01])
lam, NA = 632.8e-9, 1.0
k_max = (2 * np.pi / lam) * NA
delk = 2 * k_max / 33

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
all_stats_data = []
all_zeros_vault = np.zeros((num_runs, len(target_points), 32), dtype=complex)

print(f"🚀 Starting 50-Run Statistical Analysis with Advanced Optimization Controls...")

for run_id in range(num_runs):
    # 2.1 数据生成与 8:2 切分
    X_raw, Y_raw = create_dataset(5000)

    X_train, X_val, Y_train, Y_val = train_test_split(
        X_raw, Y_raw, test_size=0.20, random_state=42 + run_id, shuffle=True
    )

    model = SuperResNet().to(device)
    optimizer = optim.Adam(model.parameters(), lr=5e-4)
    criterion = nn.MSELoss()

    # 动态步长衰减器（10代不降，学习率减半）
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode='min', factor=0.5, patience=10, min_lr=1e-6
    )

    train_loader = DataLoader(
        TensorDataset(torch.FloatTensor(X_train), torch.FloatTensor(Y_train)),
        batch_size=128, shuffle=True
    )

    val_x = torch.FloatTensor(X_val).to(device)
    val_y = torch.FloatTensor(Y_val).to(device)

    best_val_loss = np.inf
    best_model_state = None
    max_epochs = 400         
    patience = 25           
    patience_counter = 0
    min_delta = 1e-8        

    for epoch in range(max_epochs):
        # ----------------- 训练阶段 -----------------
        model.train()
        epoch_loss = 0.0
        for bx, by in train_loader:
            bx, by = bx.to(device), by.to(device)
            optimizer.zero_grad()
            pred = model(bx)
            loss = criterion(pred, by)
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item()

        avg_train_loss = epoch_loss / len(train_loader)

        # ----------------- 验证阶段 -----------------
        model.eval()
        with torch.no_grad():
            pred_val = model(val_x)
            avg_val_loss = criterion(pred_val, val_y).item()

        scheduler.step(avg_val_loss)

        if avg_val_loss < best_val_loss - min_delta:
            best_val_loss = avg_val_loss
            best_model_state = copy.deepcopy(model.state_dict()) # 深度克隆最佳状态
            patience_counter = 0
        else:
            patience_counter += 1

        if patience_counter >= patience:
            break 

    model.load_state_dict(best_model_state)

    # 2.2
    model.eval()
    for idx, tp in enumerate(target_points):
        with torch.no_grad():
            t_in = torch.FloatTensor([[1.8, tp]]).to(device)
            pred = model(t_in).cpu().numpy()[0]
            zn = pred[:32] + 1j * pred[32:]

            angles = np.angle(zn)
            p_angs = angles[angles > 0]; n_angs = angles[angles < 0]
            if len(p_angs) > 0 and len(n_angs) > 0:
                m_res = (np.min(p_angs) + np.abs(np.max(n_angs))) / (2 * delk * lam)
            else:
                m_res = np.nan

            all_stats_data.append({'Target': tp, 'Measured': m_res})
            all_zeros_vault[run_id, idx, :] = zn

    if (run_id + 1) % 5 == 0 or (run_id + 1) == num_runs:
        print(f"Run {run_id+1:02d}/{num_runs} | Best Val MSE: {best_val_loss:.6e} | Stopped at Epoch {epoch}")

